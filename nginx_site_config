server {
    server_name mytelebot.com www.mytelebot.com;

    client_max_body_size 50M;

    location = /favicon.ico { access_log off; log_not_found off; }
    
    location /static/ {
        alias /var/www/bot_management_system/staticfiles/;
    }

    location /media/ {
        alias /var/www/bot_management_system/media/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/var/www/bot_management_system/bot_management_system.sock;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mytelebot.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mytelebot.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = mytelebot.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name mytelebot.com www.mytelebot.com;
    return 404; # managed by Certbot


}