# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-eb-url.elasticbeanstalk.com,yourdomain.com

# Database Configuration (Local Development)
DB_ENGINE=django.db.backends.mysql
DB_NAME=bot_management_db
DB_USER=bot_user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3307

# AWS S3 Configuration
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-secret

# Security (Production only)
CSRF_TRUSTED_ORIGINS=https://your-eb-url.elasticbeanstalk.com,https://yourdomain.com
